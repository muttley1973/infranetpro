# -------------------------------------------------------
#  InfraNet Pro — .gitignore
# -------------------------------------------------------

# Dipendenze npm (si reinstallano con: npm install)
node_modules/

# Bundle esbuild del frontend (artefatto di build: si rigenera con npm run build)
dist/

# Git worktree locali (es. .worktrees/<branch>): checkout separati con dist/ propri,
# non fanno parte del repo — mai versionarli né lintarli.
.worktrees/

# Dati progetti salvati localmente (non versionare dati utente)
projects/

# Libreria skin pannello caricate localmente (asset utente)
skins/

# -------------------------------------------------------
# Strumenti e catture SNMP locali (non versionare)
# -------------------------------------------------------
# Simulatore SNMP di rete / UPS-ATS (kit di test locale)
tools/snmp-sim/
# Harness compatibilità .snmprec: loader + test + catture di device reali
# (possono contenere dati personali — restano locali; vedi COMPATIBILITY.md)
tools/snmprec.js
test/snmprec-replay.test.js
test/fixtures/snmprec/
# Generatori di progetti demo/test (producono dati locali in projects/)
tools/gen-demo-network.js
tools/gen-2rack-demo.js
tools/gen-company-demo.js
tools/gen-enterprise-500.js
# Script di scan/debug temporanei (scratch, non versionare)
tools/_*.js

# -------------------------------------------------------
# Driver-pack DHCP a pagamento (fuori dal repo pubblico)
# -------------------------------------------------------
# I driver API vendor live (FortiGate/PAN-OS/OPNsense/MikroTik…) sono l'add-on
# commerciale: il framework (registry + endpoint) è open, i driver restano locali
# e si caricano a runtime da qui se installati. L'open ha solo file/incolla.
server/dhcp-drivers/vendor/

# Moduli a pagamento in-process (piattaforma plugin generica): il core espone il
# seam (autoloader modules/*/server + GET /api/modules + onProjectDelete), i
# moduli restano PRIVATI e si caricano a runtime da qui se installati.
# Es. modules/<nome>/. Il repo pubblico non deve MAI contenerli.
modules/

# -------------------------------------------------------
# Windows
# -------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -------------------------------------------------------
# Editor / IDE
# -------------------------------------------------------
.vscode/
.idea/
.claude/
*.sublime-project
*.sublime-workspace

# -------------------------------------------------------
# Log e file temporanei
# -------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# -------------------------------------------------------
# Variabili d'ambiente (non committare credenziali)
# -------------------------------------------------------
.env
.env.local
.env*.local

# -------------------------------------------------------
# Auth — dati sensibili (non versionare)
# -------------------------------------------------------
# password hashate degli utenti
users.json
# chiave sessione auto-generata
.session-secret
# token REST API (hash sha-256 dei token; segreti — vedi server/api-tokens.js)
# `*` copre anche il .bak della scrittura atomica (contiene gli hash dei token).
api-tokens.json*
# config Assistente AI: endpoint/modello/enabled + chiave BYO. La chiave NON deve
# MAI finire nel repo (override anche via env INFRANET_AI_KEY) — vedi server/ai-config.js
# `*` copre anche i .bak/.tmp lasciati dalla scrittura atomica (contengono la chiave).
data/ai-config.json*
# config Sincronizzazione DCIM/IPAM: url + token dell'istanza esterna (es. NetBox).
# Il token NON deve MAI finire nel repo (override via env INFRANET_DCIM_TOKEN) —
# vedi server/dcim-config.js. `*` copre anche il .bak della scrittura atomica.
data/dcim-config.json*

# -------------------------------------------------------
# Catalogo device-types — snapshot canonico generato (non versionare)
# -------------------------------------------------------
# device-types-canonical.json è l'output "full-fidelity" del generatore
# (scripts/update-device-types.js → `npm run update-device-types`): ~33 MB, NON
# letto a runtime (solo statSync della dimensione, con fallback a 0) e rigenerabile
# dal NetBox devicetype-library (ref/sha pinnati nel manifest). Restano versionati
# il runtime data/device-types.json, il manifest, il diff e i piccoli file di
# controllo (aliases/overrides/exclusions).
data/organization.json
data/organization.json.bak
data/device-types-canonical.json

# -------------------------------------------------------
# Runtime / backup locali (non versionare)
# -------------------------------------------------------
.server-runtime.err
backup_reset/

# -------------------------------------------------------
# Screenshot temporanei (non versionare)
# -------------------------------------------------------
# Codex / agent screenshots: hash-named PNG in root
[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].png

# -------------------------------------------------------
# Documenti di lavoro / pianificazione interna (non versionare)
# -------------------------------------------------------
ROADMAP_STRATEGICA_2026.md
# Roadmap di monetizzazione (strategia commerciale interna)
COMMERCIAL_ROADMAP.md
# Guida authoring skin (know-how riservato per gli skin-pack a pagamento)
PANEL_SKIN_ILLUSTRATOR.md
# Diario di progetto / handoff / runbook / spec interne — restano locali (2026-06-22)
HANDOFF_*.md
MEMORIA_PROGETTO_INFRANETPRO.md
DISCOVERY_TOPOLOGY_ROADMAP.md
HANDOFF_UX_TOOLBAR.md
MIGRATION_ESM.md
PANEL_SKIN_MVP.md
# Doc tecnici/decisionali interni — la sorgente resta locale (i PDF del manuale sono il deliverable pubblico)
MANUALE_TECNICO.md
DECISIONS.md
SQLITE_MIGRATION.md

# -------------------------------------------------------
# Manuale PDF — sorgente/temporanei di build (il PDF è il deliverable; restano locali)
# -------------------------------------------------------
# HTML di build da cui si rigenera MANUALE_TECNICO.pdf (tenuto in locale per le modifiche)
_manual_build*.html
# PDF temporaneo prima dello swap + screenshot di verifica
_manual_new.pdf
_v_*.png
# Asset Ko-fi / branding (banner, logo): sorgenti HTML + PNG — restano locali
_kofi_*
_logo_square.*

# -------------------------------------------------------
# Cartella di lavoro locale — mai nel repo
# -------------------------------------------------------
# Tutto ciò che non fa parte del repo pubblico (marketing, sorgenti manuale,
# note/handoff interni) vive qui dentro: _local/marketing, _local/manual-src, _local/notes
_local/
# Sicurezza extra: se un render ricrea questi asset in root, restano ignorati
_li_*
_gh_social*
