# Mai nel contesto di build (riduce l'immagine + evita binari nativi host-specifici)
node_modules
npm-debug.log*
.git
.gitignore

# Artefatto di build (rigenerato dentro l'immagine da `node build.js`)
dist

# Dati utente / runtime (vivono nel volume /data, non nell'immagine)
projects
skins
users.json
.session-secret

# SEGRETI: mai nel contesto di build → mai cotti nei layer dell'immagine.
# A runtime vivono nel volume /data (vedi le ENV INFRANET_*_FILE nel Dockerfile).
api-tokens.json
api-tokens*.json
data/ai-config.json
data/ai-config.json*
data/dcim-config.json
data/dcim-config.json*

# Catalogo canonico (33 MB, rigenerabile via `npm run update-device-types`):
# non serve a runtime (solo un statSync per lo stato) e gonfierebbe l'immagine.
data/device-types-canonical.json

# Cartella di lavoro locale + archivi + roba di sessione
_local
_archive
.claude
.vscode
.idea

# Test e tooling non necessari a runtime
test
tools
scripts

# Docker stesso + env
Dockerfile
docker-compose.yml
.dockerignore
.env
.env.*

# Doc, manuali, immagini e asset marketing (non servono al server)
*.md
*.pdf
GitHub Images
_li_*
_gh_social*
_kofi_*
_logo_square.*
_manual_build*.html

# Log e temporanei
*.log
*.bundle
